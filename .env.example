# BahaRoute environment configuration
#
# Copy this file to `.env.local` (which is gitignored) and set a real value.
# Never commit a real access token — `.env`, `.env.local`, and `.env.*.local`
# are ignored by .gitignore.

# Mapbox access token used to authenticate map tile / style requests. The real
# token belongs in `.env.local` (gitignored) and is read at runtime via
# `import.meta.env.VITE_MAPBOX_ACCESS_TOKEN`. If unset, the app shell still
# renders with a config-incomplete message and no map tiles load.
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Optional Windy Webcams API key. Read only by the Node camera proxy; never use
# a VITE_ prefix, because Vite would expose it to browser code.
WINDY_WEBCAMS_API_KEY=your_windy_webcams_api_key_here
